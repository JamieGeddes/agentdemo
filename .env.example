# ─── LLM (Gemini via LangChain) ────────────────────────────────────────────
# Backend: "gemini-api" (default, Google AI Studio key) or "vertex" (Vertex AI).
LLM_BACKEND=gemini-api
# Required when LLM_BACKEND=gemini-api; ignored for vertex. https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
# Any current Gemini Flash model id (same ids work on both backends).
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI only (LLM_BACKEND=vertex). Auth is via Application Default Credentials —
# run `gcloud auth application-default login` locally, no key goes in this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1

# ─── Ports / wiring ─────────────────────────────────────────────────────────
# Fastify (REST API + CopilotKit runtime endpoint)
SERVER_PORT=4000
# LangGraph dev server (apps/agent), started by `langgraphjs dev`
AGENT_PORT=2024
# Use explicit 127.0.0.1, not "localhost": services bind IPv4 and on dual-stack
# hosts "localhost" resolves ::1 (IPv6) first, which refuses → ECONNREFUSED.
AGENT_URL=http://127.0.0.1:2024
# Vite dev server (apps/web)
WEB_PORT=5173

# Where the agent's server-tools call the ticketing REST API
SERVER_API_URL=http://127.0.0.1:4000

# ─── External remote MCP server (DeepWiki: public, no auth) ──────────────────
DEEPWIKI_MCP_URL=https://mcp.deepwiki.com/mcp

# ─── Local internal-runbooks MCP server (apps/runbooks-mcp) ──────────────────
# Started by `npm run dev`; serves internal product/operational runbooks.
RUNBOOKS_MCP_PORT=4100
RUNBOOKS_MCP_URL=http://127.0.0.1:4100/mcp

# ─── A2A subagents (apps/subagent-insights, apps/subagent-admin) ─────────────
# Both bind 127.0.0.1 but advertise a DUMMY hostname in their Agent Card so they
# look "remote". Add these to /etc/hosts to make the dummy names resolve locally:
#   127.0.0.1 insights-agent.vela.internal account-admin.vela.internal vela-desk.vela.internal
# The main agent discovers them from the repo-root a2a-agents.json manifest.
INSIGHTS_PORT=4200
INSIGHTS_HOST=127.0.0.1
INSIGHTS_PUBLIC_URL=http://insights-agent.vela.internal:4200
# Python account-admin subagent (Google ADK). Run `npm run setup:admin` once first.
ADMIN_PORT=4300
ADMIN_HOST=127.0.0.1
ADMIN_PUBLIC_HOST=account-admin.vela.internal
# Optional: override the A2A subagent manifest path / per-subagent load timeout, and
# how often the agent re-reads the manifest + re-resolves cards (so newly registered
# subagents are picked up without a restart).
# A2A_MANIFEST_PATH=./a2a-agents.json
# A2A_TIMEOUT_MS=10000
# A2A_REFRESH_MS=30000
