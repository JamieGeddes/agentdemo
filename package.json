{
  "name": "agentdemo",
  "version": "1.0.0",
  "private": true,
  "description": "PoC: agentic layer for a B2B support/ticketing app (LangGraph + CopilotKit/AG-UI + Fastify + React + MCP)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:agent": "npm run dev --workspace apps/agent",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:runbooks": "npm run dev --workspace apps/runbooks-mcp",
    "reset": "npm run reset --workspace apps/server",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server --noEmit && tsc -p apps/agent --noEmit && tsc -p apps/web --noEmit && tsc -p apps/runbooks-mcp --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24"
  }
}
